APP_NAME="GoLuckyTen"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Company details shown in the footer, legal pages and emails
COMPANY_NAME="GoLuckyTen Ltd"
COMPANY_NUMBER="00000000"
COMPANY_ADDRESS="1 Example Street, Riga, LV-1010, Latvia"
COMPANY_EMAIL="support@goluckyten.com"
FREE_ENTRY_EMAIL="freeentry@goluckyten.com"
APP_CURRENCY=EUR
# €0.10 tickets; ticket pool = prize value × 10 (a €100 prize gets 10,000 tickets)
TICKET_PRICE_CENTS=10
TICKET_VALUE_MULTIPLIER=10
MIN_PLAYER_AGE=18

# true = show the landing page at / (the competitions home moves to /home)
LANDING_AS_HOME=false

# Invoices (VAT line only appears when COMPANY_VAT_RATE > 0)
INVOICE_PREFIX=LT
COMPANY_VAT_NUMBER=
COMPANY_VAT_RATE=0

# Wallet & referrals (cents)
REFERRAL_BONUS_CENTS=100
REFERRAL_MIN_SPEND_CENTS=100
WITHDRAWAL_MIN_CENTS=1000

# Browser push notifications: run `php artisan push:vapid` and paste the keys here
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
