# Production .env for /var/www/goluckyten.com — copy to .env and fill the CHANGE_ME values.
APP_NAME="GoLuckyTen"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://goluckyten.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=goluckyten
DB_USERNAME=goluckyten
# Random password generated in docs/DEPLOY.md step 3 and written here in step 5.1
DB_PASSWORD=GENERATED_IN_STEP_3

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Real email (any SMTP provider: Postmark, Mailgun, Brevo, Amazon SES, your host...)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="support@goluckyten.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

COMPANY_NAME="GoLuckyTen Ltd"
COMPANY_NUMBER="CHANGE_ME"
COMPANY_ADDRESS="CHANGE_ME"
COMPANY_EMAIL="support@goluckyten.com"
FREE_ENTRY_ADDRESS="GoLuckyTen Free Entry, 1 Example Street, Riga, LV-1010, Latvia"
APP_CURRENCY=EUR
TICKET_PRICE_CENTS=10
TICKET_VALUE_MULTIPLIER=10
MIN_PLAYER_AGE=18

LANDING_AS_HOME=true

INVOICE_PREFIX=GLT
COMPANY_VAT_NUMBER=
COMPANY_VAT_RATE=0

REFERRAL_BONUS_CENTS=100
REFERRAL_MIN_SPEND_CENTS=100
WITHDRAWAL_MIN_CENTS=1000

# php artisan push:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:support@goluckyten.com"
